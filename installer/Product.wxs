<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Grabador de Pantalla"
           Manufacturer="Dariel Verdecia"
           Version="1.0.0.0"
           UpgradeCode="7B1D2E9C-4A3F-4C21-9E6B-2F8A1C0D5E34"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="Ya hay una versión más reciente instalada." />

    <!-- Empaqueta todo el contenido dentro del propio .msi (un solo archivo) -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Icono en Agregar/Quitar programas -->
    <Icon Id="AppIcon" SourceFile="$(PublishDir)\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/DarielVerdecia93/grabador-de-pantalla" />

    <!-- Carpeta de instalacion: Archivos de programa\Grabador de Pantalla -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Grabador de Pantalla" />
    </StandardDirectory>

    <!-- Accesos directos: menu inicio y escritorio -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuDir" Name="Grabador de Pantalla" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <!-- Todos los archivos publicados (self-contained) -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**" />
    </ComponentGroup>

    <!-- Componente con accesos directos -->
    <Component Id="Shortcuts" Directory="AppProgramMenuDir" Guid="*">
      <Shortcut Id="StartMenuShortcut"
                Name="Grabador de Pantalla"
                Target="[INSTALLFOLDER]GravadorTela.WinUI.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <Shortcut Id="DesktopShortcut"
                Directory="DesktopFolder"
                Name="Grabador de Pantalla"
                Target="[INSTALLFOLDER]GravadorTela.WinUI.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon" />
      <RemoveFolder Id="RemoveStartMenuDir" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\GrabadorDePantalla"
                     Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Grabador de Pantalla" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>

    <!-- UI estandar con pantalla de bienvenida, carpeta y progreso -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\License.rtf" />

  </Package>
</Wix>
