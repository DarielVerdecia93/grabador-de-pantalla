<Window
    x:Class="GravadorTela.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Gravador de Tela">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de titulo personalizada (estilo Windows 11) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="13"
                       Text="Gravador de Tela" />
        </Grid>

        <Grid Grid.Row="1" Padding="24,8,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Monitor -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Monitor:" VerticalAlignment="Center" />
            <ComboBox x:Name="MonitorBox" Grid.Column="1" HorizontalAlignment="Stretch" />
        </Grid>

        <!-- FPS -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="FPS:" VerticalAlignment="Center" />
                <ComboBox x:Name="FpsBox" SelectedIndex="1" MinWidth="90">
                    <ComboBoxItem Content="24" />
                    <ComboBoxItem Content="30" />
                    <ComboBoxItem Content="60" />
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="AudioCheck" Content="Grabar audio del sistema" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Carpeta -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Carpeta:" VerticalAlignment="Center" />
            <TextBox x:Name="FolderBox" Grid.Column="1" IsReadOnly="True" />
            <Button x:Name="FolderButton" Grid.Column="2" Content="..." Click="OnPickFolder" />
        </Grid>

        <StackPanel Grid.Row="3" VerticalAlignment="Center" Spacing="10">
            <Button x:Name="RecordButton" Click="OnRecordClick"
                    HorizontalAlignment="Stretch" Height="56" FontSize="18"
                    Content="● Grabar" />
            <TextBlock x:Name="EncoderLabel" Text="" HorizontalAlignment="Center"
                       Foreground="{ThemeResource SystemAccentColor}" />
        </StackPanel>

        <TextBlock x:Name="StatusLabel" Grid.Row="4" Text="Listo"
                   HorizontalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
